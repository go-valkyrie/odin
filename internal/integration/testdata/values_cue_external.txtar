# Test the "cue:" values location tag: an independent, self-rooted CUE
# module living entirely outside the bundle's own directory tree, still able
# to resolve its own dependency (example.com/platform) via the bundle's
# registry configuration.

odin-setup
exec odin cue mod tidy
cd external-values
odin-setup
exec odin cue mod tidy
cd ..
exec odin template . -f 'cue: ./external-values'
cmp stdout expected.yaml

# A cue: location that isn't a directory is rejected up front.
! exec odin template . -f 'cue: ./external-values/values.cue'
stderr 'must be a directory'

-- cue.mod/module.cue --
module: "test.example.com/cueexternal@v0"
language: version: "v0.14.0"
deps: {
    "example.com/platform@v0": {
        v: "v0.0.0-test"
    }
    "go-valkyrie.com/odin/api@v0": {
        v: "v0.0.1"
    }
}

-- bundle.cue --
package bundle

import (
    odin "go-valkyrie.com/odin/api/v1alpha1"
    "example.com/platform/workload"
)

odin.#Bundle & {
    metadata: name: "values-cue-external"

    components: {
        api: workload.#WebApp & {
            metadata: name: "api"
        }
    }

    values: {
        // Leave as constraints, no defaults
        components: {
            api: {
                image: string
                replicas: uint
            }
        }
    }
}

-- external-values/cue.mod/module.cue --
module: "test.example.com/extvalues@v0"
language: version: "v0.14.0"
deps: {
    "example.com/platform@v0": {
        v: "v0.0.0-test"
    }
}

-- external-values/values.cue --
package extvalues

import "example.com/platform/workload"

// Referencing workload.#WebApp proves this independently-rooted module can
// resolve its own registry dependency, decoupled from the bundle's module.
// A cue: location's top-level content IS the values content directly (like
// yaml:/json: locations), not wrapped in a "values:" field -- it doesn't
// share the bundle's module identity, so that wrapper convention (only
// meaningful for .cue values files living inside the bundle's own module)
// wouldn't deep-merge the same way.
_proof: workload.#WebApp

components: {
    api: {
        image:    "api:prod"
        replicas: 5
    }
}

-- expected.yaml --
# api.deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
spec:
  replicas: 5
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      containers:
        - image: api:prod
          name: api
          ports:
            - containerPort: 80
---
# api.service
apiVersion: v1
kind: Service
metadata:
  name: api
spec:
  ports:
    - port: 80
      targetPort: 80
  selector:
    app: api
