# Regression test for the CUE v0.17 "directory is in a nested module" bug.
#
# The bundle ("app") lives in a subdirectory of a larger tree whose root also
# happens to have its own (unrelated) cue.mod -- e.g. a monorepo layout. The
# values live in an untagged directory inside the bundle's own module. odin
# is invoked from the outer root, not from the bundle directory, so the
# process's cwd sits under the *wrong* module for CUE's default module-root
# resolution. Before the fix, this failed with:
#   cannot determine import path for "./app/values" (directory is in a nested module)

cd app
odin-setup
exec odin cue mod tidy
cd ..
exec odin template ./app -f ./app/values
cmp stdout expected.yaml

-- cue.mod/module.cue --
module: "outer.example.com@v0"
language: version: "v0.14.0"

-- app/cue.mod/module.cue --
module: "test.example.com/app@v0"
language: version: "v0.14.0"
deps: {
    "example.com/platform@v0": {
        v: "v0.0.0-test"
    }
    "go-valkyrie.com/odin/api@v0": {
        v: "v0.0.1"
    }
}

-- app/bundle.cue --
package bundle

import (
    odin "go-valkyrie.com/odin/api/v1alpha1"
    "example.com/platform/workload"
)

odin.#Bundle & {
    metadata: name: "nested-module-values"

    components: {
        api: workload.#WebApp & {
            metadata: name: "api"
        }
    }

    values: {
        // Leave as constraints, no defaults
        components: {
            api: {
                image: string
                replicas: uint
            }
        }
    }
}

-- app/values/values.yaml --
components:
  api:
    image: api:prod
    replicas: 5

-- expected.yaml --
# api.deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
spec:
  replicas: 5
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      containers:
        - image: api:prod
          name: api
          ports:
            - containerPort: 80
---
# api.service
apiVersion: v1
kind: Service
metadata:
  name: api
spec:
  ports:
    - port: 80
      targetPort: 80
  selector:
    app: api
